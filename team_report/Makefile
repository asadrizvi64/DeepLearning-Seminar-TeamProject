.PHONY: all clean sync preview

all: main.pdf

main.pdf: main.tex appendix.tex definitions.tex references.bib $(wildcard assets/*.pdf) $(wildcard figs/*) $(wildcard generated/*)
	latexmk -pdf -interaction=nonstopmode -halt-on-error main.tex

clean:
	latexmk -c main.tex

# Copy the numbers and tables generated by scripts/fidelity/paper_numbers.py
sync:
	cp ../paper/numbers.tex ../paper/table_main.tex ../paper/table_radius.tex generated/

# Without TeX Live: approximate build with Tectonic (see build_preview.py)
preview:
	python build_preview.py
